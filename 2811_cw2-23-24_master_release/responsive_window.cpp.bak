#include "responsive_window.h"
#include "responsive_layout.h"
#include "screenshot.h"
#include <iostream>
#include <QVBoxLayout>
#include <QHBoxLayout>
#include <QGridLayout>
#include <QApplication>


ResponsiveWindow::ResponsiveWindow() {

    setWindowTitle("2811: Coursework 1");
    setMinimumSize(320, 320);
    setMaximumSize(1280, 720);

    createWidgets();
}

void ResponsiveWindow::createWidgets() {

    compactLayout = new ResponsiveLayout();
    // Add horizontal and vertical layouts
    horizontalLayout = new QHBoxLayout();
    verticalLayout = new QVBoxLayout();


    // add all the widgets we need to demonstrate all layouts
    compactLayout->addWidget(new ResponsiveLabel(kNavTabs));
    compactLayout->addWidget(new ResponsiveLabel(kSearchButton));
    // we might have more than one search results
    compactLayout->addWidget(new ResponsiveLabel(kSearchResult));
    compactLayout->addWidget(new ResponsiveLabel(kSearchResult));
    compactLayout->addWidget(new ResponsiveLabel(kSearchText));
    // Add Home, Menu, shopping basket and Sign in
    compactLayout->addWidget(new ResponsiveLabel(kShoppingBasket));
    compactLayout->addWidget(new ResponsiveLabel(kSignIn));
    compactLayout->addWidget(new ResponsiveLabel(kAdvert));
    compactLayout->addWidget(new ResponsiveLabel(kHomeLink));
    compactLayout->addWidget(new ResponsiveLabel(KMenu));
    // Add Search Option and previous and next
    compactLayout->addWidget(new ResponsiveLabel(kSearchOptions));
    compactLayout->addWidget(new ResponsiveLabel(kSearchBackward));
    compactLayout->addWidget(new ResponsiveLabel(kSearchForward));
    // Add Search result image and text
    compactLayout->addWidget(new ResponsiveLabel(kSResultImage));
    compactLayout->addWidget(new ResponsiveLabel(KSResultText));
    // note that later widgets are drawn on top of earlier widgets

    // Add widgets to the horizontal layout
    horizontalLayout->addWidget(new ResponsiveLabel(kHomeLink));
    horizontalLayout->addWidget(new ResponsiveLabel(KMenu));
    horizontalLayout->addWidget(new ResponsiveLabel(kSearchText));
    horizontalLayout->addWidget(new ResponsiveLabel(kSearchButton));
    horizontalLayout->addWidget(new ResponsiveLabel(kSearchResult));
    horizontalLayout->addWidget(new ResponsiveLabel(kAdvert));

    // Add widgets to the vertical layout
    verticalLayout->addWidget(new ResponsiveLabel(kNavTabs));
    verticalLayout->addWidget(new ResponsiveLabel(kSearchText));
    verticalLayout->addWidget(new ResponsiveLabel(kSearchButton));
    verticalLayout->addWidget(new ResponsiveLabel(kSearchResult));
    verticalLayout->addWidget(new ResponsiveLabel(kShoppingBasket));
    verticalLayout->addWidget(new ResponsiveLabel(kSignIn));
    verticalLayout->addWidget(new ResponsiveLabel(kAdvert));


    setLayout(compactLayout);
}


// This method will switch between layouts based on window size and aspect ratio
void ResponsiveWindow::resizeEvent(QResizeEvent *event) {
    QSize newSize = event->size();

    // Switch to compact layout if window is too small
    if (newSize.width() < 500) {
        switchToCompactLayout();
    }
    // Switch to horizontal layout if width is greater than height
    else if (newSize.width() > newSize.height()) {
        switchToHorizontalLayout();
    }
    // Otherwise, switch to vertical layout
    else {
        switchToVerticalLayout();
    }
}

void ResponsiveWindow::switchToCompactLayout() {
    // Remove the current layout and switch to compact layout
    if (layout() != compactLayout) {
        delete layout();  // Remove current layout
        setLayout(compactLayout);
    }
}

void ResponsiveWindow::switchToHorizontalLayout() {
    if (layout() != horizontalLayout) {
        delete layout();  // Remove current layout
        setLayout(horizontalLayout);
    }
}

void ResponsiveWindow::switchToVerticalLayout() {
    if (layout() != verticalLayout) {
        delete layout();  // Remove current layout
        setLayout(verticalLayout);
    }
}

